<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.youtubearchiver.youtubearchiver.MainController">

    <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="160" maxWidth="160" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" fillWidth="true" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>

   <children>
   
       <Label text="Hello World!" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.halignment="CENTER" />
       <Label text="First Name" GridPane.columnIndex="0" GridPane.rowIndex="1" />
       <Label text="Last Name" GridPane.columnIndex="0" GridPane.rowIndex="2" />

       <TextField fx:id="firstNameText" GridPane.columnIndex="1" GridPane.rowIndex="1" />
       <TextField fx:id="lastNameText" GridPane.columnIndex="1" GridPane.rowIndex="2" />

       <Button onAction="#onShowButtonClick" text="Show Person" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />

   </children>

</GridPane>
