<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets.*?>

<?import javafx.geometry.Insets?>

<?import org.controlsfx.control.StatusBar?>

<SplitPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@style.css"
           fx:controller="com.youtubearchiver.youtubearchiver.MainController"
           orientation="VERTICAL">

    <!-- Top Layout -->
    <StackPane>

        <SplitPane>

            <!-- Top Left Layout -->
            <StackPane maxWidth="600" minWidth="360">
                <GridPane>

                    <columnConstraints>
                        <ColumnConstraints maxWidth="160" minWidth="160" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints maxHeight="32.0" minHeight="32.0" />
                        <RowConstraints fillHeight="true" vgrow="ALWAYS" />
                    </rowConstraints>

                    <children>

                        <!-- Youtube Channel / Video URL -->
                        <HBox fx:id="youtubeControlPane" styleClass="hbox" GridPane.columnSpan="2">
                            <padding>
                                <Insets left="5" top="5" right="5" bottom="5" />
                            </padding>

                            <Label text="Youtube URL"
                                   prefHeight="32"
                                   alignment="CENTER_LEFT" >
                            </Label>

                            <TextField fx:id="youtubeURLText" minWidth="200" HBox.hgrow="ALWAYS">
                            </TextField>

                            <!-- Execute Button -->
                            <Button fx:id="searchButton"
                                    onMouseClicked="#onSearchButtonClicked"
                                    text="Search"
                                    disable="${running}">
                            </Button>
                        </HBox>

                        <!-- Youtube Channel's Video List -->
                        <ListView fx:id="videoListView" GridPane.rowIndex="1" GridPane.columnSpan="2" />

                    </children>

                </GridPane>
            </StackPane>

            <!-- Top Right Layout -->
            <StackPane>
                <!-- Youtube Comment List -->
                <ListView fx:id="commentListView"  />
            </StackPane>

        </SplitPane>

    </StackPane>

    <!-- Bottom Layout -->
    <StackPane  maxHeight="500" minHeight="200">
        <GridPane>

            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
                <RowConstraints maxHeight="24.0" minHeight="24.0" vgrow="NEVER" />
            </rowConstraints>

            <!-- Log Output -->
            <TextArea fx:id="outputTextArea" editable="false" />

            <!-- Status Bar -->
            <StatusBar fx:id="statusBar" minHeight="24" maxHeight="24" GridPane.rowIndex="1" />
        </GridPane>
    </StackPane>

</SplitPane>


