<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets.*?>

<?import javafx.geometry.Insets?>

<?import org.controlsfx.control.StatusBar?>

<SplitPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@style.css"
           fx:controller="com.youtubearchiver.youtubearchiver.MainController"
           orientation="VERTICAL">

    <fx:define>
        <Insets fx:id="DefaultMargin" top="3" bottom="3" left="3" right="3" />
    </fx:define>

    <!-- Top Layout -->
    <StackPane>

        <SplitPane>

            <!-- Top Left Layout -->
            <StackPane maxWidth="600" minWidth="360" prefWidth="360">

                <!-- Entity Tree -->
                <fx:include source="entity-view.fxml"  />

            </StackPane>

            <!-- Top Right Layout -->
            <StackPane>

                <!-- Entity List -->
                <ListView fx:id="entityListView"  />

            </StackPane>

        </SplitPane>

    </StackPane>

    <!-- Bottom Layout -->
    <StackPane  maxHeight="500" minHeight="200">
        <fx:include source="output-view.fxml" />
    </StackPane>

</SplitPane>


