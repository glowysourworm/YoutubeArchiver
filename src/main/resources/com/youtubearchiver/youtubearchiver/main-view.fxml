<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@style.css"
           fx:id="mainSplitPane"
           fx:controller="com.youtubearchiver.youtubearchiver.Controller.MainController"
           orientation="VERTICAL">

    <!-- Top Layout -->
    <AnchorPane>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="ALL_TABS"
                 AnchorPane.bottomAnchor="0"
                 AnchorPane.topAnchor="0"
                 AnchorPane.leftAnchor="0"
                 AnchorPane.rightAnchor="0">

            <!-- Entity Tab -->
            <Tab closable="false" text="Local Database">
                <fx:include source="entity-view.fxml" maxWidth="Infinity" maxHeight="Infinity" />
            </Tab>

        </TabPane>
    </AnchorPane>

    <!-- Bottom Layout -->
    <VBox fx:id="bottomPane" maxHeight="500" minHeight="32">

        <!-- Terminal Tool Bar -->
        <ToolBar fx:id="bottomToolbar" minHeight="32" maxHeight="32">

            <!-- Force Align Right -->
            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="toggleConsoleButton"
                    onMouseClicked="#onToggleConsoleClicked"
                    minHeight="24"
                    maxHeight="24">
                <!-- Initialize in code -->
            </Button>
        </ToolBar>

        <!-- Terminal Output -->
        <fx:include fx:id="outputView" source="output-view.fxml" VBox.vgrow="ALWAYS" />

    </VBox>

</SplitPane>


