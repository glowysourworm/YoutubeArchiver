<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.kordamp.ikonli.Ikonli?>
<SplitPane xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           stylesheets="@style.css"
           fx:id="mainSplitPane"
           fx:controller="com.youtubearchiver.youtubearchiver.MainController"
           orientation="VERTICAL">

    <fx:define>
        <Insets fx:id="DefaultMargin" top="3" bottom="3" left="3" right="3" />
    </fx:define>

    <!-- Top Layout -->
    <StackPane>

        <SplitPane>

            <!-- Top Left Layout -->
            <StackPane maxWidth="600" minWidth="360" prefWidth="360">

                <!-- Entity Tree -->
                <fx:include source="entity-view.fxml"  />

            </StackPane>

            <!-- Top Right Layout -->
            <StackPane>

                <!-- Entity List -->
                <ListView fx:id="entityListView"  />

            </StackPane>

        </SplitPane>

    </StackPane>

    <!-- Bottom Layout -->
    <VBox fx:id="bottomPane" maxHeight="500" minHeight="32">

        <!-- Terminal Tool Bar -->
        <ToolBar fx:id="bottomToolbar" minHeight="32" maxHeight="32">

            <!-- Force Align Right -->
            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="toggleConsoleButton"
                    onMouseClicked="#onToggleConsoleClicked"
                    minHeight="24"
                    maxHeight="24">
                <!-- Initialize in code -->
            </Button>
        </ToolBar>

        <!-- Terminal Output -->
        <fx:include fx:id="outputView" source="output-view.fxml" VBox.vgrow="ALWAYS" />

    </VBox>

</SplitPane>


