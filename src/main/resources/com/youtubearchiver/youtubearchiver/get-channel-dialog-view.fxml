<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<!-- Dialog Pattern:  Child view for dialog-view-base.fxml -->
<GridPane xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="com.youtubearchiver.youtubearchiver.Dialog.Controller.GetChannelDialogController"
          AnchorPane.bottomAnchor="0"
          AnchorPane.topAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.leftAnchor="0">

    <columnConstraints>
        <ColumnConstraints minWidth="140" maxWidth="140" />
        <ColumnConstraints minWidth="300" maxWidth="300" />
    </columnConstraints>

    <Label text="Channel URL (or ID)" />
    <TextField fx:id="textInput" GridPane.columnIndex="1" />
</GridPane>
