<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            styleClass="dialog-view-base"
            stylesheets="@style.css">

    <GridPane>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints maxHeight="48" minHeight="48" />
        </rowConstraints>

        <!-- Child View -->
        <AnchorPane fx:id="childContainer">
            <padding>
                <Insets left="5" right="5" top="5" bottom="5" />
            </padding>
        </AnchorPane>

        <!-- Description -->
        <Text fx:id="descriptionText" GridPane.rowIndex="1" GridPane.halignment="RIGHT">
            <GridPane.margin>
                <Insets left="5" right="5" top="5" bottom="5" />
            </GridPane.margin>
        </Text>

        <!-- Dialog Buttons -->
        <HBox spacing="5" GridPane.rowIndex="2" alignment="CENTER_RIGHT">
            <padding>
                <Insets left="5" right="5" top="5" bottom="5" />
            </padding>

            <Button text="Cancel" />
            <Button text="Ok" />
        </HBox>

    </GridPane>

</AnchorPane>
